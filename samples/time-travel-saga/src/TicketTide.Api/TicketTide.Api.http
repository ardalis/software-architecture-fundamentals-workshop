# Time Travel Saga requests. Start the AppHost first: dotnet run --project src/TicketTide.AppHost
@api = http://localhost:5240

### Events on sale and seats left
GET {{api}}/inventory/events

### Happy path: buy two tickets
# @name happy
POST {{api}}/orders
Content-Type: application/json

{
  "eventId": "midnight-tide",
  "quantity": 2,
  "fanEmail": "fan@example.com",
  "paymentToken": "tok_visa"
}

### Follow the saga for that order
GET {{api}}/orders/{{happy.response.body.$.orderId}}

### Failure path: Ticketing fails twice, Payments retries, and the order is still confirmed (201)
# @name retried
POST {{api}}/orders
Content-Type: application/json

{
  "eventId": "midnight-tide",
  "quantity": 2,
  "fanEmail": "patient-fan@example.com",
  "paymentToken": "tok_visa",
  "simulateTicketingFailures": 2
}

### Nothing was rolled back: the seats are Held, the card is Charged, and Ticketing took 3 attempts
GET {{api}}/inventory/holds/{{retried.response.body.$.orderId}}

###
GET {{api}}/payments/{{retried.response.body.$.orderId}}

###
GET {{api}}/tickets/{{retried.response.body.$.orderId}}

### Longer outage: Ticketing fails 8 times, more than Payments retries while the fan waits (202 Pending)
# @name pending
POST {{api}}/orders
Content-Type: application/json

{
  "eventId": "midnight-tide",
  "quantity": 2,
  "fanEmail": "very-patient-fan@example.com",
  "paymentToken": "tok_visa",
  "simulateTicketingFailures": 8
}

### Run this a few times: Pending, then Confirmed once Payments' background retries get through
GET {{api}}/orders/{{pending.response.body.$.orderId}}

###
GET {{api}}/tickets/{{pending.response.body.$.orderId}}

### Payment declined: Inventory releases its seats and Ticketing is never called
POST {{api}}/orders
Content-Type: application/json

{
  "eventId": "midnight-tide",
  "quantity": 1,
  "fanEmail": "declined-fan@example.com",
  "paymentToken": "tok_declined"
}

### Sold out: Back Room Sessions only has 4 seats
POST {{api}}/orders
Content-Type: application/json

{
  "eventId": "back-room-sessions",
  "quantity": 5,
  "fanEmail": "late-fan@example.com",
  "paymentToken": "tok_visa"
}
