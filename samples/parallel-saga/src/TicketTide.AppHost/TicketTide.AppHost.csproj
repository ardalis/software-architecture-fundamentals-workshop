<Project Sdk="Aspire.AppHost.Sdk/13.6.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>tickettide-parallel-saga-apphost</UserSecretsId>
    <!-- Runs with plain `dotnet run`; the Aspire CLI bundle is optional. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.PapercutSmtp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketTide.Api\TicketTide.Api.csproj" />
  </ItemGroup>

</Project>
