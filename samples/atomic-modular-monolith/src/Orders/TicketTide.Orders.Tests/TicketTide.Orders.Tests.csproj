<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Orders module on its own: its rules and handlers, and its boundaries. No Docker needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketTide.Orders.Internal\TicketTide.Orders.Internal.csproj" />
  </ItemGroup>

  <!-- Shared test helpers. Edit them in tests/TestSupport, not a copy. -->
  <ItemGroup>
    <Compile Include="..\..\..\tests\TestSupport\SqliteDatabase.cs" Link="TestSupport\SqliteDatabase.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TicketTide.TestSupport" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
